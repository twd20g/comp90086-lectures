{
  "energyDark": "E(\\textcolor{dv}{u},\\textcolor{dv}{v}) \\;=\\; \\sum_{x,y} \\textcolor{da}{w(x,y)} \\Big[\\, I(x+\\textcolor{dv}{u},\\, y+\\textcolor{dv}{v}) \\;-\\; I(x,y) \\,\\Big]^{2}",
  "energyLight": "E(\\textcolor{rv}{u},\\textcolor{rv}{v}) \\;=\\; \\sum_{x,y} \\textcolor{ra}{w(x,y)} \\Big[\\, I(x+\\textcolor{rv}{u},\\, y+\\textcolor{rv}{v}) \\;-\\; I(x,y) \\,\\Big]^{2}",
  "taylorDark": "I(x+\\textcolor{dv}{u},\\, y+\\textcolor{dv}{v}) \\;\\approx\\; I(x,y) \\;+\\; \\textcolor{dv}{u}\\,\\textcolor{dk}{I_x} \\;+\\; \\textcolor{dv}{v}\\,\\textcolor{dk}{I_y} \\qquad\\Longrightarrow\\qquad E(\\textcolor{dv}{u},\\textcolor{dv}{v}) \\;\\approx\\; \\sum_{x,y} \\textcolor{da}{w(x,y)} \\big[\\, \\textcolor{dv}{u}\\,\\textcolor{dk}{I_x} + \\textcolor{dv}{v}\\,\\textcolor{dk}{I_y} \\,\\big]^{2}",
  "taylorLight": "I(x+\\textcolor{rv}{u},\\, y+\\textcolor{rv}{v}) \\;\\approx\\; I(x,y) \\;+\\; \\textcolor{rv}{u}\\,\\textcolor{rk}{I_x} \\;+\\; \\textcolor{rv}{v}\\,\\textcolor{rk}{I_y} \\qquad\\Longrightarrow\\qquad E(\\textcolor{rv}{u},\\textcolor{rv}{v}) \\;\\approx\\; \\sum_{x,y} \\textcolor{ra}{w(x,y)} \\big[\\, \\textcolor{rv}{u}\\,\\textcolor{rk}{I_x} + \\textcolor{rv}{v}\\,\\textcolor{rk}{I_y} \\,\\big]^{2}",
  "quadDark": "E(\\textcolor{dv}{u},\\textcolor{dv}{v}) \\;\\approx\\; \\begin{bmatrix} \\textcolor{dv}{u} & \\textcolor{dv}{v} \\end{bmatrix} \\; \\textcolor{dq}{M} \\; \\begin{bmatrix} \\textcolor{dv}{u} \\\\ \\textcolor{dv}{v} \\end{bmatrix} \\qquad\\text{where}\\qquad \\textcolor{dq}{M} \\;=\\; \\sum_{x,y} \\textcolor{da}{w(x,y)} \\begin{bmatrix} \\textcolor{dk}{I_x^{2}} & \\textcolor{dk}{I_x I_y} \\\\[2pt] \\textcolor{dk}{I_x I_y} & \\textcolor{dk}{I_y^{2}} \\end{bmatrix}",
  "quadLight": "E(\\textcolor{rv}{u},\\textcolor{rv}{v}) \\;\\approx\\; \\begin{bmatrix} \\textcolor{rv}{u} & \\textcolor{rv}{v} \\end{bmatrix} \\; \\textcolor{rq}{M} \\; \\begin{bmatrix} \\textcolor{rv}{u} \\\\ \\textcolor{rv}{v} \\end{bmatrix} \\qquad\\text{where}\\qquad \\textcolor{rq}{M} \\;=\\; \\sum_{x,y} \\textcolor{ra}{w(x,y)} \\begin{bmatrix} \\textcolor{rk}{I_x^{2}} & \\textcolor{rk}{I_x I_y} \\\\[2pt] \\textcolor{rk}{I_x I_y} & \\textcolor{rk}{I_y^{2}} \\end{bmatrix}",
  "structureDark": "\\textcolor{dq}{M} \\;=\\; \\sum_{x,y} \\textcolor{da}{w(x,y)} \\begin{bmatrix} \\textcolor{dk}{I_x^{2}} & \\textcolor{dk}{I_x I_y} \\\\[2pt] \\textcolor{dk}{I_x I_y} & \\textcolor{dk}{I_y^{2}} \\end{bmatrix} \\qquad \\textcolor{dk}{I_x} = \\frac{\\partial I}{\\partial x}, \\qquad \\textcolor{dk}{I_y} = \\frac{\\partial I}{\\partial y}",
  "structureLight": "\\textcolor{rq}{M} \\;=\\; \\sum_{x,y} \\textcolor{ra}{w(x,y)} \\begin{bmatrix} \\textcolor{rk}{I_x^{2}} & \\textcolor{rk}{I_x I_y} \\\\[2pt] \\textcolor{rk}{I_x I_y} & \\textcolor{rk}{I_y^{2}} \\end{bmatrix} \\qquad \\textcolor{rk}{I_x} = \\frac{\\partial I}{\\partial x}, \\qquad \\textcolor{rk}{I_y} = \\frac{\\partial I}{\\partial y}",
  "eigenDark": "\\det(\\textcolor{dq}{M}) \\;=\\; \\textcolor{da}{\\lambda_1}\\textcolor{da}{\\lambda_2} \\qquad\\qquad \\operatorname{tr}(\\textcolor{dq}{M}) \\;=\\; \\textcolor{da}{\\lambda_1} + \\textcolor{da}{\\lambda_2}",
  "eigenLight": "\\det(\\textcolor{rq}{M}) \\;=\\; \\textcolor{ra}{\\lambda_1}\\textcolor{ra}{\\lambda_2} \\qquad\\qquad \\operatorname{tr}(\\textcolor{rq}{M}) \\;=\\; \\textcolor{ra}{\\lambda_1} + \\textcolor{ra}{\\lambda_2}",
  "harrisDark": "R \\;=\\; \\det(\\textcolor{dq}{M}) \\;-\\; \\textcolor{ds}{k}\\,\\big(\\operatorname{tr}\\textcolor{dq}{M}\\big)^{2} \\;=\\; \\textcolor{da}{\\lambda_1}\\textcolor{da}{\\lambda_2} \\;-\\; \\textcolor{ds}{k}\\,(\\textcolor{da}{\\lambda_1}+\\textcolor{da}{\\lambda_2})^{2}",
  "harrisLight": "R \\;=\\; \\det(\\textcolor{rq}{M}) \\;-\\; \\textcolor{rs}{k}\\,\\big(\\operatorname{tr}\\textcolor{rq}{M}\\big)^{2} \\;=\\; \\textcolor{ra}{\\lambda_1}\\textcolor{ra}{\\lambda_2} \\;-\\; \\textcolor{rs}{k}\\,(\\textcolor{ra}{\\lambda_1}+\\textcolor{ra}{\\lambda_2})^{2}",
  "altDark": "\\text{Shi--Tomasi (1994):}\\quad \\min(\\textcolor{da}{\\lambda_1},\\textcolor{da}{\\lambda_2}) \\qquad\\qquad \\text{Brown, Szeliski \\& Winder (2005):}\\quad \\frac{\\det \\textcolor{dq}{M}}{\\operatorname{tr} \\textcolor{dq}{M}}",
