{
  "homog": "\\begin{pmatrix} x \\\\ y \\end{pmatrix} \\;\\longleftrightarrow\\; \\lambda\\begin{pmatrix} x \\\\ y \\\\ 1 \\end{pmatrix}, \\qquad \\lambda \\neq 0",
  "pinhole": "\\begin{pmatrix} x_i \\\\ y_i \\\\ z_i \\end{pmatrix} \\;=\\; \\begin{pmatrix} f_x & 0 & c_x & 0 \\\\ 0 & f_y & c_y & 0 \\\\ 0 & 0 & 1 & 0 \\end{pmatrix} \\begin{pmatrix} X \\\\ Y \\\\ Z \\\\ 1 \\end{pmatrix}",
