  "linf": "\\mathbf{l}_\\infty \\;=\\; (0,\\,0,\\,1)^{\\top} \\qquad \\mathbf{l}_\\infty \\cdot (x,\\,y,\\,0)^{\\top} \\;=\\; 0",
  "rot": "R^{\\top}R \\;=\\; I \\qquad \\det R \\;=\\; +1",
