  "camera": "\\mathbf{x} \\;=\\; \\underbrace{\\begin{pmatrix} f_x & 0 & c_x \\\\ 0 & f_y & c_y \\\\ 0 & 0 & 1 \\end{pmatrix}}_{K}\\;\\underbrace{\\bigl[\\,R \\mid \\mathbf{t}\\,\\bigr]}_{\\text{pose}}\\;\\mathbf{X}",
  "planeZ": "K\\bigl[\\,\\mathbf{r}_1\\;\\mathbf{r}_2\\;\\mathbf{r}_3\\;\\mathbf{t}\\,\\bigr]\\begin{pmatrix} X \\\\ Y \\\\ 0 \\\\ 1 \\end{pmatrix} \\;=\\; \\underbrace{K\\bigl[\\,\\mathbf{r}_1\\;\\mathbf{r}_2\\;\\mathbf{t}\\,\\bigr]}_{3\\times 3}\\begin{pmatrix} X \\\\ Y \\\\ 1 \\end{pmatrix}",
  "hpair": "\\mathbf{x}' \\;=\\; \\underbrace{K'\\bigl[\\,\\mathbf{r}'_1\\;\\mathbf{r}'_2\\;\\mathbf{t}'\\,\\bigr]\\;\\bigl(K\\bigl[\\,\\mathbf{r}_1\\;\\mathbf{r}_2\\;\\mathbf{t}\\,\\bigr]\\bigr)^{-1}}_{H,\\;\\;8\\text{ degrees of freedom}}\\;\\mathbf{x}",
  "crossmat": "[\\mathbf{t}]_\\times \\;=\\; \\begin{pmatrix} 0 & -t_z & t_y \\\\ t_z & 0 & -t_x \\\\ -t_y & t_x & 0 \\end{pmatrix} \\qquad [\\mathbf{t}]_\\times \\mathbf{v} \\;=\\; \\mathbf{t} \\times \\mathbf{v}",
  "coplanar": "\\hat{\\mathbf{x}}' \\cdot \\bigl(\\mathbf{t} \\times R\\,\\hat{\\mathbf{x}}\\bigr) \\;=\\; 0",
  "essential": "\\hat{\\mathbf{x}}'^{\\top} E\\, \\hat{\\mathbf{x}} \\;=\\; 0 \\qquad E \\;=\\; [\\mathbf{t}]_\\times R",
  "epiline": "\\mathbf{l}' \\;=\\; E\\,\\hat{\\mathbf{x}} \\qquad \\hat{\\mathbf{x}}' \\cdot \\mathbf{l}' \\;=\\; 0 \\qquad E\\,\\mathbf{e} \\;=\\; \\mathbf{0}",
  "fund": "\\mathbf{x}'^{\\top} F\\, \\mathbf{x} \\;=\\; 0 \\qquad F \\;=\\; K'^{-\\top} E\\, K^{-1}",
  "eightrow": "\\bigl(\\,x x'\\;\\; y x'\\;\\; x'\\;\\; x y'\\;\\; y y'\\;\\; y'\\;\\; x\\;\\; y\\;\\; 1\\,\\bigr)\\,\\mathbf{f} \\;=\\; 0"
